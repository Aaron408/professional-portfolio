# Archivo de configuración para el entorno de desarrollo

# Configuración del servidor local
PORT=3000
HOST=localhost

# URLs del proyecto
DEV_URL=http://localhost:3000
DEMO_URL=http://localhost:3000/demo.html
PROD_URL=https://tu-portfolio.com

# Configuración de desarrollo
NODE_ENV=development
DEBUG=true

# Configuración de build
BUILD_DIR=dist
SOURCE_DIR=.

# Configuración de testing
TEST_PORT=3001
TEST_URL=http://localhost:3001

# Archivos principales
MAIN_HTML=index-componentized.html
DEMO_HTML=demo.html
MAIN_JS=components/PortfolioApp.js
MAIN_CSS=assets/css/style.css

# Directorios importantes
COMPONENTS_DIR=components
UTILS_DIR=utils
DATA_DIR=data
ASSETS_DIR=assets
EXAMPLES_DIR=examples

# Configuración de GitHub Pages (si usas GitHub Pages)
# GITHUB_PAGES_BRANCH=gh-pages
# GITHUB_PAGES_DIR=docs
